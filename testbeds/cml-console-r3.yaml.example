# Copy to testbeds/lab-r3.yaml (gitignored) for the second-platform run
# (scripts/lab/run-second-platform.sh), which adds R3 to default-lab with
# `scripts/lab/cml_lab.py add-r3 <platform>`. R1 and R2 are reached as in
# cml-console.yaml.example; R3 through the same console server. Prepared, not run yet: no
# connection to an R3 has been made, and the R3 entry was checked only against Unicon's own
# mock devices. Never point this at a work production network.
#
# R3 below is an NX-OS 9000v (`cml_lab.py add-r3 nxosv9000`). NX-OS asks for its own login
# after the CML one, so the connection lists two credentials in order: `default` (the CML
# login) and `nxos`, the admin user cml_lab.py put into R3's day-0 configuration with
# NCV_LAB_PASS as its password. `login_creds` must sit in the connection block next to
# `command:`: under `arguments:` Unicon ignores it and the second prompt fails. `platform: n9k`
# picks Unicon's 9000 plugin; do not use `platform: nxosv`, which is for the old NX-OSv.
# `SENDLINE_AFTER_CRED: default` makes Unicon press Enter once after it sends the `default` (CML)
# password, to clear a `Password:` prompt left over from the two-credential login; that was
# checked against Unicon's mock devices only. R1 and R2 do not set it, as in
# cml-console.yaml.example.
#
# For a Catalyst 8000V or IOSv R3 (`add-r3 cat8000v` or `add-r3 iosv`), replace the R3 entry
# with the IOS form: the day-0 configuration sets no console login, so the console needs only
# the CML login, as R1 and R2 do.
#
#   R3:
#     os: iosxe            # cat8000v; `os: ios` for iosv
#     type: router
#     connections:
#       cli:
#         command: 'ssh -tt -o StrictHostKeyChecking=accept-new %ENV{NCV_CML_USER}@10.10.20.161 "open /default-lab/R3/0"'
#         arguments:
#           learn_hostname: true
#           prompt_recovery: true
#           connection_timeout: 120
#
# run-second-platform.sh refuses to start when R3's `os` here is not the one its platform
# needs.
#
#   export NCV_CML_USER=... NCV_CML_PASS=... NCV_LAB_PASS=...

testbed:
  name: cml-console-lab-r3
  credentials:
    default:
      username: "%ENV{NCV_CML_USER}"
      password: "%ENV{NCV_CML_PASS}"
    enable:
      password: "%ENV{NCV_LAB_PASS}"

devices:
  R1:
    os: iosxe
    type: router
    connections:
      cli:
        command: 'ssh -tt -o StrictHostKeyChecking=accept-new %ENV{NCV_CML_USER}@10.10.20.161 "open /default-lab/R1/0"'
        arguments:
          learn_hostname: true
          prompt_recovery: true
  R2:
    os: iosxe
    type: router
    connections:
      cli:
        command: 'ssh -tt -o StrictHostKeyChecking=accept-new %ENV{NCV_CML_USER}@10.10.20.161 "open /default-lab/R2/0"'
        arguments:
          learn_hostname: true
          prompt_recovery: true
  R3:
    os: nxos
    platform: n9k
    type: switch
    credentials:
      nxos:
        username: admin
        password: "%ENV{NCV_LAB_PASS}"
    connections:
      cli:
        command: 'ssh -tt -o StrictHostKeyChecking=accept-new %ENV{NCV_CML_USER}@10.10.20.161 "open /default-lab/R3/0"'
        login_creds: [default, nxos]
        settings:
          SENDLINE_AFTER_CRED: default
        arguments:
          learn_hostname: true
          prompt_recovery: true
          connection_timeout: 120
